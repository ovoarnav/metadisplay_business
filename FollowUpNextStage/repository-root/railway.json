{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "DOCKERFILE", "dockerfilePath": "Dockerfile.followup" },
  "deploy": {
    "healthcheckPath": "/health", "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE", "restartPolicyMaxRetries": 3,
    "numReplicas": 1, "requiredMountPath": "/data",
    "sleepApplication": false, "overlapSeconds": 0
  }
}
