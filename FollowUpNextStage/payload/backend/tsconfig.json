{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true,
    "outDir": "dist", "rootDir": "src", "types": ["node"],
    "rewriteRelativeImportExtensions": true, "erasableSyntaxOnly": true
  },
  "include": ["src/**/*.ts"]
}
